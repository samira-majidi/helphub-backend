# Application
PORT=8080

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here
DATABASE_NAME=helphub_db
DATABASE_SYNC=false
DATABASE_AUTOLOAD=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_TOKEN_AUDIENCE=http://localhost:3000
JWT_TOKEN_ISSUER=http://localhost:8080
JWT_ACCESS_TOKEN_TTL=86400
JWT_REFRESH_TOKEN_TTL=86400

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Arvan Cloud Object Storage Configuration (S3 Compatible)
ARVAN_ACCESS_KEY=your_arvan_access_key
ARVAN_SECRET_KEY=your_arvan_secret_key
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_BUCKET_NAME=helphub-images
ARVAN_REGION=ir-thr-at1

# Frontend Client URL
CLIENT_URL=http://localhost:3000
